  m_text: "\t\u0418\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u043F\u043B\u0430\u043D\u0435\u0442\u0430 \xAB\u041D\u0435\u043C\u0442\u043E\u043F\xBB
    \u0431\u044B\u043B\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \u043A\u0430\u043A \u0441\u0430\u043C\u043E\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u044B\u0439
    \u043D\u0430\u0443\u0447\u043D\u044B\u0439 \u0430\u0432\u0430\u043D\u043F\u043E\u0441\u0442:
    \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044B\u0435 \u044D\u043A\u043E\u0441\u0438\u0441\u0442\u0435\u043C\u044B,
